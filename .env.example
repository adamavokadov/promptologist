# Copy to .env for local development. NEVER commit real values. On the platform these are injected as deploy env.
# Service key (vibe_api_...) for AI router, search, infra, notifications and background jobs.
VIBE_API_KEY=REPLACE_WITH_vibe_api_KEY
# OAuth application key (vibe_app_...); used with the forwarded user session to resolve identity via GET /v1/me.
VIBE_APP_KEY=REPLACE_WITH_vibe_app_KEY
VIBE_BASE_URL=https://vibecode.bitrix24.com/v1
# Server (Galaxy container or VM) that hosts this app; used to register the scheduler job.
VIBE_SERVER_ID=REPLACE_WITH_SERVER_ID
# Public https address of the deployed app; used for the keep-alive self-ping.
APP_PUBLIC_URL=REPLACE_WITH_APP_URL
# Signing secret of the scheduled job (shown once on creation). Optional: the app also keeps it on the data volume.
JOB_SECRET=
# Previous secret accepted during rotation (optional).
JOB_SECRET_PREVIOUS=
# Encrypts provider API keys saved in Settings (AES-256-GCM, min 16 chars). Without it keys cannot be saved.
ENGINE_SECRET=REPLACE_WITH_RANDOM_SECRET
# Allow Custom Base URL on private networks or plain http (local proxies only). Leave unset in production.
ENGINE_ALLOW_PRIVATE=
# Persistent directory. Auto-detected (/data on Galaxy, /opt/app/data on a VM) when empty.
DATA_DIR=
NODE_ENV=production
# Injected by the platform. Local default 3000.
PORT=3000
# Optional bind address. Use 127.0.0.1 for direct local smoke tests.
# HOST=127.0.0.1
# Local development only (ignored in production): skip Gateway identity.
DEV_AUTH_BYPASS=0
# Optional override of the CSP frame-ancestors list.
FRAME_ANCESTORS=
