{
  "name": "promptolog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Promptolog: prompt generator with self-updating per-system skills, built for the Alaio Vibecode (Bitrix24) platform.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev:server": "node --experimental-strip-types apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:server": "esbuild apps/server/src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "start": "node dist/server.js",
    "test": "vitest run",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack:source": "node scripts/pack-source.mjs",
    "pack:repomix": "npx --yes repomix",
    "docs:changelog": "python3 scripts/docs_update.py changelog",
    "docs:handoff": "python3 scripts/docs_update.py handoff",
    "docs:release": "python3 scripts/docs_update.py release"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "diff": "^9.0.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
